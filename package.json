{
  "name": "autoreadme",
  "version": "1.0.0",
  "description": "Generador automático de README.md basado en análisis de código fuente",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "autoreadme": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && npm run build:desktop",
    "build:desktop": "tsup --config tsup.desktop.config.ts && node scripts/copy-renderer.mjs",
    "app": "npm run build && electron dist/desktop/main.js",
    "app:dev": "electron dist/desktop/main.js",
    "app:pack": "npm run build && electron-builder --win --publish never",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests desktop",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"desktop/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "readme",
    "generator",
    "documentation",
    "cli",
    "automation",
    "electron"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "build": {
    "appId": "com.autoreadme.app",
    "productName": "AutoReadme",
    "extraMetadata": {
      "main": "dist/desktop/main.js"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "fast-glob": "^3.3.3",
    "openai": "^4.91.0",
    "smol-toml": "^1.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^22.13.10",
    "electron": "^35.1.2",
    "electron-builder": "^25.1.8",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vitest": "^3.0.9"
  }
}
